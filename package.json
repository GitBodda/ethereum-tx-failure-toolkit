{
  "name": "ethereum-tx-failure-toolkit",
  "version": "1.0.0",
  "description": "Toolkit for analyzing and classifying Ethereum transaction failures with structured JSON output.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "txft": "bin/txft"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "ethereum",
    "transaction",
    "failure",
    "cli",
    "debugging",
    "json",
    "toolkit"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GitBodda/ethereum-tx-failure-toolkit"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "tsx": "^4.0.0",
    "@types/node": "^20.0.0",
    "vitest": "^1.0.0"
  }
}
